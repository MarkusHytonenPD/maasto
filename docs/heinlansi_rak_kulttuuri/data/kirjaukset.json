  {
   "tunnus": "42",
   "taho": "Kaavoittaja",
   "luokitus_vir": "ei_suojeluarvoja",
   "kommentti_vir": "Kohde on autio ja heikkokuntoinen. Kasvillisuus ja puusto kasvaa ja vaurioittaa perustuksia",
   "nimi_vir": ""
  },
  {
   "tunnus": "52",
   "taho": "Kaavoittaja",
   "luokitus_vir": "ei_suojeluarvoja",
