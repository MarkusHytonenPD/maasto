   "kommentti_vir": "",
   "nimi_vir": ""
  },
  {
   "tunnus": "12",
   "taho": "Kaavoittaja",
   "luokitus_vir": "lisatietoja",
   "kommentti_vir": "Käydään läpi arkeologien kanssa",
   "nimi_vir": ""
  },
  {
   "tunnus": "21",
   "taho": "Kaavoittaja",
